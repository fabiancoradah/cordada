rules_version = '2';
// Reglas para la sincronización de Cordada.
// Cada salida es un documento con un id largo y aleatorio que funciona como llave:
// solo quien tiene el link de invitación puede leerla o editarla.
// No se permite listar salidas ni borrarlas desde la app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow get: if request.auth != null && tripId.size() >= 20;
      allow create, update: if request.auth != null && tripId.size() >= 20;
    }
  }
}
